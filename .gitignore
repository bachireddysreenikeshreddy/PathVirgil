# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts

# Maintained Vite plugin and worker sources.
!/build/
/build/*
!/build/connector-preview-plugin.mjs
!/build/connector-preview-worker.mjs
!/build/harbor-package-plugin.ts
!/build/harbor-worker.ts

/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.harbor-runtime/
/.agents/
/outputs/
/work/

!.env.example
android/build/
*.keystore

# Generated Pages deployment configuration with account database IDs
/wrangler.pages.json
/wrangler.jsonc

# Local installer helpers
.harbor-tools/
